# ------------------------------------------------------------------------------
# Configuration de sécurité Apache - EdNum (HEP-VS)
# ------------------------------------------------------------------------------

# Désactiver le listing automatique des répertoires
Options -Indexes

# Bloquer l'accès aux dossiers et fichiers sensibles (retourne 404 Not Found)
# Protège les workflows CI/CD, templates d'actions, et métadonnées Git
RedirectMatch 404 /\.github
RedirectMatch 404 /\.git
RedirectMatch 404 /\.env

# Bloquer l'accès aux fichiers de dépendances et de configuration (403 Forbidden)
<FilesMatch "^(package(-lock)?\.json|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
